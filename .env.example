# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password

# Public URL of this dashboard (no trailing slash)
APP_URL=https://your-domain.example/dashboardbbh

# MOPH Health ID / Provider ID
# Start with UAT first.
MOPH_HEALTH_ID_URL=https://uat-moph.id.th
MOPH_PROVIDER_URL=https://uat-provider.id.th

# Health ID credentials
MOPH_CLIENT_ID=YOUR_HEALTH_ID_CLIENT_ID
MOPH_CLIENT_SECRET=YOUR_HEALTH_ID_CLIENT_SECRET

# Provider ID credentials
MOPH_PROVIDER_CLIENT_ID=YOUR_PROVIDER_ID_CLIENT_ID
MOPH_PROVIDER_SECRET_KEY=YOUR_PROVIDER_ID_SECRET_KEY

# Must exactly match the redirect URI registered with Health ID.
MOPH_REDIRECT_URI=https://your-domain.example/dashboardbbh/auth/provider_callback.php

# Optional: restrict login to a specific hospital HCODE.
# Leave empty to allow any valid Provider ID.
MOPH_ALLOWED_HCODE=
